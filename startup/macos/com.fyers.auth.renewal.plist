<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  FYERS Auth Utility — macOS LaunchAgent template

  Install (does NOT run automatically until you load it):
    1. Edit FYERS_PROJECT_ROOT below to your project path
    2. cp startup/macos/com.fyers.auth.renewal.plist ~/Library/LaunchAgents/
    3. launchctl load ~/Library/LaunchAgents/com.fyers.auth.renewal.plist

  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.fyers.auth.renewal.plist
    rm ~/Library/LaunchAgents/com.fyers.auth.renewal.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.fyers.auth.renewal</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>cd FYERS_PROJECT_ROOT &amp;&amp; source venv/bin/activate 2>/dev/null; python -m auth_helper.main</string>
    </array>

    <key>WorkingDirectory</key>
    <string>FYERS_PROJECT_ROOT</string>

    <key>RunAtLoad</key>
    <true/>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>FYERS_PROJECT_ROOT/logs/auth.launchd.log</string>

    <key>StandardErrorPath</key>
    <string>FYERS_PROJECT_ROOT/logs/auth.launchd.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
    </dict>
</dict>
</plist>
